	      "properties": { 
	        "redis.conn.count": { "type": "integer"  }, 
			"rt.event": { "type": "text"  },
			"rt.conn.count": { "type": "integer"  }, 
			"rt.realtime.p1": { "type": "integer"  }, 
			"rt.realtime.p2": { "type": "integer"  }, 
			"rt.realtime.p3": { "type": "integer"  }, 
			"request": { "type": "text"  }
	      }
	    }
	  }
}
