apiVersion: "v1"
kind: "PersistentVolume"
metadata:
  annotations:
      volume.beta.kubernetes.io/mount-options: "discard"
  name: <<namespace>>-postgis
  labels:
    das.component: <<namespace>>-postgis
spec:
  capacity:
    storage: "50Gi"
  accessModes:
    - "ReadWriteOnce"
  persistentVolumeReclaimPolicy: Retain
  storageClassName: ssd
  gcePersistentDisk:
    fsType: "ext4"
    pdName: "<<cluster-name>>-<<namespace>>-postgres-0"
  nodeAffinity:
    required:
      nodeSelectorTerms:
      - matchExpressions:
        - key: failure-domain.beta.kubernetes.io/zone
          operator: In
          values:
          - us-west-1a
        - key: failure-domain.beta.kubernetes.io/region
          operator: In
          values:
          - us-west1
