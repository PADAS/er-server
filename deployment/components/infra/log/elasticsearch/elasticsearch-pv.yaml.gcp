apiVersion: "v1"
kind: "PersistentVolume"
metadata:
  annotations:
      volume.beta.kubernetes.io/mount-options: "discard"
  name: <<namespace>>-elasticsearch-data-0
  labels:
    component: <<namespace>>-elasticsearch-data-0
spec:
  capacity:
    storage: "100Gi"
  accessModes:
    - "ReadWriteOnce"
  persistentVolumeReclaimPolicy: Retain
  storageClassName: "ssd"
  gcePersistentDisk:
    fsType: "ext4"
    pdName: "<<cluster-name>>-<<namespace>>-elasticsearch-data-0"
---
