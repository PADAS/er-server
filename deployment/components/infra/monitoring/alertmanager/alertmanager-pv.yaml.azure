apiVersion: "v1"
kind: "PersistentVolume"
metadata:
  annotations:
      volume.beta.kubernetes.io/mount-options: "discard"
  name: <<infra-namespace>>-alertmanager
  labels:
    component: <<infra-namespace>>-alertmanager
spec:
  capacity:
    storage: "20Gi"
  accessModes:
    - "ReadWriteOnce"
  persistentVolumeReclaimPolicy: Retain
  storageClassName: ssd
  azureDisk:
    kind: Managed
    diskURI: "/subscriptions/<<azure-subscription-id>>/resourceGroups/<<iaas-workspace>>/providers/Microsoft.Compute/disks/<<cluster-name>>-<<infra-namespace>>-alertmanager-0"
    diskName: "<<cluster-name>>-<<infra-namespace>>-alertmanager-0"

