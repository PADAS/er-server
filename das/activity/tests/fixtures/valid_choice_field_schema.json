{
    "json": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "unevaluatedProperties": false,
        "properties": {
            "testChoice": {
                "title": "Valid Choice Field",
                "type": "string",
                "description": "A valid choice field.",
                "deprecated": false,
                "anyOf": [
                    {
                        "$ref": "http://example.com/choiceA"
                    },
                    {
                        "$ref": "/choiceB/path/to/choice-reference.json"
                    },
                    {
                        "$ref": "/choiceC/path/to/choice-reference.json?param=value&param2=value2"
                    },
                    {
                        "$ref": "#/choiceD/fragment/path"
                    },
                    {
                        "$ref": "#ChoiceE_anchor_fragment"
                    },
                    {
                        "$ref": "http://example.com/choiceF/?param=value&param2=value2#anchor_fragment"
                    },
                    {
                        "$ref": "http://example.com/choiceG/#/path/fragment"
                    }
                ]
            }
        },
        "required": [
            "testChoice"
        ]
    },
    "ui": {
        "fields": {},
        "headers": {},
        "order": [],
        "sections": {}
    }
}
