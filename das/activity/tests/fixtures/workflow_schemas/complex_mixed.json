{
  "json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "unevaluatedProperties": false,
    "properties": {
      "incident_description": {
        "deprecated": false,
        "description": "Detailed description of the incident",
        "title": "Incident Description",
        "type": "string"
      },
      "priority_level": {
        "deprecated": false,
        "description": "",
        "title": "Priority Level",
        "type": "string",
        "anyOf": [
          {
            "$ref": "/api/v2.0/schemas/choices.json?field=service_type"
          }
        ]
      },
      "affected_subjects": {
        "deprecated": false,
        "description": "Wildlife affected by incident",
        "title": "Affected Wildlife",
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "anyOf": [
            {
              "$ref": "/api/v2.0/schemas/subjects.json?subject_subtype=wildlife"
            }
          ]
        }
      },
      "estimated_count": {
        "deprecated": false,
        "description": "Estimated number of affected animals",
        "title": "Estimated Count",
        "type": "number",
        "minimum": 0,
        "maximum": 1000
      }
    },
    "required": [
      "incident_description",
      "priority_level"
    ],
    "type": "object"
  },
  "ui": {
    "fields": {
      "incident_description": {
        "inputType": "LONG_TEXT",
        "placeholder": "Provide detailed description...",
        "type": "TEXT",
        "parent": "section-1"
      },
      "priority_level": {
        "choices": {
          "eventTypeCategories": [],
          "existingChoiceList": [
            "service_type"
          ],
          "featureCategories": [],
          "myDataType": "",
          "subjectGroups": [],
          "subjectSubtypes": [],
          "type": "EXISTING_CHOICE_LIST"
        },
        "inputType": "DROPDOWN",
        "placeholder": "",
        "type": "CHOICE_LIST",
        "parent": "section-1"
      },
      "affected_subjects": {
        "choices": {
          "eventTypeCategories": [],
          "existingChoiceList": [],
          "featureCategories": [],
          "myDataType": "SUBJECTS_FROM_SUBJECT_SUBTYPE",
          "subjectGroups": [],
          "subjectSubtypes": [
            "wildlife"
          ],
          "type": "MY_DATA"
        },
        "inputType": "LIST",
        "placeholder": "",
        "type": "CHOICE_LIST",
        "parent": "section-2"
      },
      "estimated_count": {
        "placeholder": "Enter count",
        "type": "NUMERIC",
        "parent": "section-2"
      }
    },
    "headers": {},
    "order": [
      "section-1",
      "section-2"
    ],
    "sections": {
      "section-1": {
        "columns": 1,
        "isActive": true,
        "label": "Incident Details",
        "leftColumn": [
          {
            "name": "incident_description",
            "type": "field"
          },
          {
            "name": "priority_level",
            "type": "field"
          }
        ],
        "rightColumn": []
      },
      "section-2": {
        "columns": 2,
        "isActive": true,
        "label": "Impact Assessment",
        "leftColumn": [
          {
            "name": "affected_subjects",
            "type": "field"
          }
        ],
        "rightColumn": [
          {
            "name": "estimated_count",
            "type": "field"
          }
        ]
      }
    }
  }
}
