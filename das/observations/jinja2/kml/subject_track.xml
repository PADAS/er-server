<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2" xmlns:gx="http://www.google.com/kml/ext/2.2" xmlns:kml="http://www.opengis.net/kml/2.2" xmlns:atom="http://www.w3.org/2005/Atom">
  <Folder>
      <name>{{ name }}</name>
      <visibility>1</visibility>


      <Document>

          <name>{{ name }} (points)</name>
          <visibility>1</visibility>
          <Style id="p-style">
              <IconStyle>
                  <color>{{ points_color}}</color>
                  <scale>0.5</scale>
                  <Icon>
                      <href>http://maps.google.com/mapfiles/kml/shapes/shaded_dot.png</href>
                  </Icon>
              </IconStyle>
              <LabelStyle>
                  <scale>0</scale>
              </LabelStyle>

          </Style>

          {% for observation in observations | sort(attribute='recorded_at') %}
          {% if loop.nextitem is defined %}
          <Placemark id="p-{{ loop.index }}">
            <Snippet>{{observation.recorded_at}}</Snippet>
            <name>{{observation.location.x }}, {{ observation.location.y }}</name>
            <description>{{observation.recorded_at}}</description>
            <TimeStamp>
              <when>{{observation.recorded_at.strftime('%Y-%m-%dT%H:%M:%SZ')}}</when>
            </TimeStamp>
            <styleUrl>p-style</styleUrl>
            <Point>
              <coordinates>
                  {{observation.location.x }}, {{ observation.location.y }}, 0
              </coordinates>
            </Point>
          </Placemark>
          {% endif %}
          {% endfor %}

      </Document>


      <Document>
          <name>{{ name }} (tracks)</name>
          <visibility>1</visibility>
          <Style id="t-linestyle">
              <LineStyle>
                  <color>{{track_color}}</color>
                  <width>0.4</width>
              </LineStyle>
          </Style>

          {% for observation in observations | sort(attribute='recorded_at') %}
          {% if loop.previtem is defined %}
          <Placemark id="t-{{ loop.index }}">
            <name/>
            <styleUrl>t-linestyle</styleUrl>
           <TimeStamp>
              <when>{{observation.recorded_at.strftime('%Y-%m-%dT%H:%M:%SZ')}}</when>
            </TimeStamp>

            <LineString>
              <extrude>1</extrude>
              <tessellate>1</tessellate>
              <coordinates>
                  {{loop.previtem.location.x }},{{ loop.previtem.location.y }},0 {{observation.location.x }},{{ observation.location.y }},1000
         </coordinates>
            </LineString>
          </Placemark>
          {% endif %}
          {% endfor %}

      </Document>




      <Document>
          <name>{{name}} (last position)</name>
          <visibility>1</visibility>
          <Style id="finalpoint_hover">
            <IconStyle>
              <scale>1</scale>
              <color>{{last_position_color}}</color>
              <Icon>
                <href>{{ subject_icon }}</href>
              </Icon>
            </IconStyle>
            <LabelStyle>
              <scale>1.1</scale>
              <color>#ffffffff</color>

            </LabelStyle>
            <BalloonStyle>
              <bgColor>aaffffff</bgColor>
              <text>$[description]</text>
            </BalloonStyle>
          </Style>
          <Style id="finalpoint_normal">
            <IconStyle>
              <scale>0.7</scale>
              <color>{{last_position_color}}</color>
              <Icon>
                <href>{{ subject_icon }}</href>
              </Icon>
            </IconStyle>
            <BalloonStyle>
              <bgColor>aaffffff</bgColor>
              <text>$[description]</text>
            </BalloonStyle>
            <LabelStyle>
              <scale>0</scale>
            </LabelStyle>
          </Style>
          <StyleMap id="finalpoint-stylemap">
            <Pair>
              <key>normal</key>
              <styleUrl>#finalpoint_normal</styleUrl>
            </Pair>
            <Pair>
              <key>highlight</key>
              <styleUrl>#finalpoint_hover</styleUrl>
            </Pair>
          </StyleMap>
          <Placemark id="">
            <Snippet/>
            <name>Last Position: {{observations[0].recorded_at}}</name>
            <description><![CDATA[
                <div style="width:275px;font-family:Verdana,Tahoma,Helvetica,Arial;padding:0px;">
                    <div style="padding:5px 0px">
                    <img src="{{subject_icon}}" align='bottom' style="background-color: gray; padding:2px 5px; height:1.2em;" border='0'/>
                    <strong style="font-size:1.2em;">{{ name }}</strong>
                    </div>
                    <div style="padding:5px 0px">{{observations[0].recorded_at }}</div>
                    <div style="padding:5px 0px">{{observations[0].location.x}}, {{observations[0].location.y}}</div>
                </div>]]>
            </description>
            <TimeStamp>
              <when>{{observations[0].recorded_at}}</when>
            </TimeStamp>
            <styleUrl>#finalpoint-stylemap</styleUrl>
            <Point>
              <coordinates>
                  {{observations[0].location.x}},{{observations[0].location.y}},0
              </coordinates>
            </Point>
          </Placemark>

          <ScreenOverlay>
              <name>logo</name>
              <visibility>1</visibility>
              <Icon>
                <href>https://107.21.94.89/Images/Logos/STE_Logo.png</href>
              </Icon>
              <overlayXY x="0" y="0" xunits="fraction" yunits="fraction"/>
              <screenXY x="0" y="0" xunits="fraction" yunits="fraction"/>
              <rotationXY x="0" y="0" xunits="fraction" yunits="fraction"/>
              <size x="0" y="0" xunits="fraction" yunits="fraction"/>
          </ScreenOverlay>
    </Document>




  </Folder>
</kml>

