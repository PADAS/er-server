ALERT DiskUsage
  IF (node_filesystem_size{mountpoint="/data"} - node_filesystem_free{mountpoint="/data"} ) / node_filesystem_size{mountpoint="/data"} > 0.8
  FOR 60m
  LABELS {
    severity = "page"
  }
  ANNOTATIONS {
    summary = "{{$labels.instance}}: Disk usage is above 80%.",
    DESCRIPTION = "{{$labels.instance}}: Disk usage is above 80% (current value is: {{ $value }})"
  }

ALERT NodeCPUUsage
  IF (1 - (avg by (instance) (irate(node_cpu{name="node-exporter", mode="idle"}[5m])))) > 0.8
  FOR 2m
  LABELS {
    severity="page"
  }
  ANNOTATIONS {
    SUMMARY = "{{$labels.instance}}: High CPU usage detected",
    DESCRIPTION = "{{$labels.instance}}: CPU usage is above 80% (current value is: {{ $value }})"
}

ALERT IOUsage
  IF (avg by (instance) (irate(node_cpu{name="node-exporter", mode="iowait"}[5m]))) > 0.8
  FOR 2m
  LABELS {
    severity="page"
  }
  ANNOTATIONS {
    SUMMARY = "{{$labels.instance}}: High IO usage detected",
    DESCRIPTION = "{{$labels.instance}}: IO usage is above 80% (current value is: {{ $value }})"
}
