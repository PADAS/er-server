{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "PyTest",
            "type": "python",
            "request": "launch",
            "stopOnEntry": false,

            "module": "pytest",
            "args": [
                "--reuse-db",
                "--ds",
                "test_scripts.unittest_settings"
            ],
            "cwd": "${workspaceRoot}/das",
            "env": {},
            "debugOptions": [
                "WaitOnAbnormalExit",
                "WaitOnNormalExit",
                "RedirectOutput"
            ]
        },
        {
            "name": "PyTest --createdb",
            "type": "python",
            "request": "launch",
            "stopOnEntry": false,
            "module": "pytest",
            "args": [
                "--create-db",
                "--reuse-db",
                "--ds",
                "test_scripts.unittest_settings",
                "core/tests/test_utils.py"
            ],
            "cwd": "${workspaceRoot}/das",
            "env": {
                "IS_OAUTH2_PROVIDER_MIGRATION": "True"
            },
            "debugOptions": [
                "WaitOnAbnormalExit",
                "WaitOnNormalExit",
                "RedirectOutput"
            ]

        },
        {
            "name": "Django:Run",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/das/manage.py",
            "console": "internalConsole",
            "cwd": "${workspaceFolder}/das",
            "env": {
                "DJANGO_SETTINGS_MODULE": "das_server.local_settings_docker",
                "ROOT_LOGGING_LEVEL": "INFO"
            },
            "args": [
                "runserver",
                "--noreload"
            ],
            "django": true,
            "justMyCode": false
        },
        {
            "name": "Django:Gunicorn",
            "type": "python",
            "request": "launch",
            "program": "/usr/local/bin/gunicorn",
            "console": "internalConsole",
            "cwd": "${workspaceFolder}/das",
            "env": {
                "DJANGO_SETTINGS_MODULE": "das_server.local_settings_docker",
                "ROOT_LOGGING_LEVEL": "INFO"
            },
            "args": [
                "das_server.wsgi",
                "--name",
                "das",
                "--limit-request-line",
                "6000",
                "--bind",
                "127.0.0.1:8000",
                "--workers",
                "1",
                "--threads",
                "1"
            ],
            "django": true,
            "justMyCode": false
        },
        {
            "name": "Django:GunicornRT",
            "type": "python",
            "request": "launch",
            "program": "/usr/local/bin/gunicorn",
            "console": "internalConsole",
            "cwd": "${workspaceFolder}/das",
            "gevent":true,
            "justMyCode": false,
            "args": [
                "das_server.rt_wsgi",
                "--name",
                "das_rt",
                "--limit-request-line",
                "6000",
                "--bind",
                "127.0.0.1:8000",
                "--workers",
                "1",
                "--worker-tmp-dir",
                "/dev/shm",
                "--worker-class",
                "eventlet",
                "--timeout",
                "600",
                "--log-level",
                "info"
            ],
            "env":{
                "DJANGO_SETTINGS_MODULE": "das_server.local_settings_docker"
            }
        },
        {
            "name": "ER Workers",
            "type": "python",
            "request": "launch",
            "program": "/usr/local/bin/celery",
            "console": "internalConsole",
            "cwd": "${workspaceFolder}/das",
            "args": [
                "-A",
                "das_server",
                "worker",
                "--beat",
                "-s",
                "/tmp/celerybeat-schedule",
                "-Q",
                "realtime_p1,realtime_p2,realtime_p3,default,analyzers,maintenance",
                "-l",
                "info",
                "-c",
                "2",
                "--without-gossip",
                "-n",
                "all-in-one"
            ],
            //"postDebugTask": "killdebugger",
            "env":{
                "DJANGO_SETTINGS_MODULE": "das_server.local_settings_docker",
                "GEVENT_SUPPORT": "True",
                "ROOT_LOGGING_LEVEL": "INFO"
            }
        },
        {
            "name": "Django:MQL",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/das/manage.py",
            "console": "internalConsole",
            "cwd": "${workspaceFolder}/das",
            "args": [
                "message_queue_listeners"
            ],
            "django": true,
            "env":{
                "DJANGO_SETTINGS_MODULE": "das_server.local_settings_docker",
                "ROOT_LOGGING_LEVEL": "INFO"
            }
        },
        {
            "name": "Django:RunRT",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/das/async_manage.py",
            "console": "internalConsole",
            "cwd": "${workspaceFolder}/das",
            "gevent": true,
            "justMyCode": false,
            "args": [
                "rtserver",
                "localhost:8000",
                "--noreload",
                "--nothreading"
            ],
            "env":{
                "DJANGO_SETTINGS_MODULE": "das_server.local_settings_docker"
            },
            "django": true
        },
        {
            "name": "Django manage command",
            "type": "python",
            "request": "launch",
            "justMyCode": false,
            "program": "${workspaceFolder}/das/manage.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/das",
            "args": [
                "shell"
            ],
            "django": true,
            "env":{
                "DJANGO_SETTINGS_MODULE": "das_server.local_settings_docker"
            }
        },
        {
            "name": "Django migrate db",
            "type": "python",
            "request": "launch",
            "justMyCode": false,
            "program": "${workspaceFolder}/das/manage.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/das",
            "args": [
                "migrate"
            ],
            "django": true,
            "env":{
                "DJANGO_SETTINGS_MODULE": "das_server.local_settings_docker",
                "IS_OAUTH2_PROVIDER_MIGRATION": "True"
            }
        }

    ]
}
