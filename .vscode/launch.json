{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Debug Tests",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "python": "/home/vscode/.venv/bin/python",
            "purpose": [
                "debug-test"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "PyTest",
            "type": "debugpy",
            "request": "launch",
            "python": "/home/vscode/.venv/bin/python",
            "stopOnEntry": false,
            "justMyCode": false,
            "module": "pytest",
            "args": [
                "-vv",
                "--ds",
                "test_scripts.unittest_settings",
                "--reuse-db",
                "${input:pytest_path_args}"
            ],
            "cwd": "${workspaceRoot}/das",
            "env": {
            },
            "redirectOutput": true
        },
        {
            "name": "PyTest --createdb",
            "type": "debugpy",
            "request": "launch",
            "python": "/home/vscode/.venv/bin/python",
            "stopOnEntry": false,
            "module": "pytest",
            "args": [
                "--create-db",
                "--reuse-db",
                "--ds",
                "test_scripts.unittest_settings",
                "core/tests/test_utils.py"
            ],
            "cwd": "${workspaceRoot}/das",
            "env": {
                "IS_OAUTH2_PROVIDER_MIGRATION": "True"
            },
            "redirectOutput": true
        },
        {
            "name": "Django:Run",
            "type": "debugpy",
            "request": "launch",
            "python": "/home/vscode/.venv/bin/python",
            "program": "manage.py",
            "console": "internalConsole",
            "cwd": "${workspaceFolder}/das",
            "env": {
                "DJANGO_SETTINGS_MODULE": "das_server.local_settings_docker_pooler",
                "PYTHONWARNINGS": "default"
            },
            "args": [
                "runserver",
                "--noreload"
            ],
            "django": true,
            "justMyCode": false
        },
        {
            "name": "Django:Gunicorn",
            "type": "debugpy",
            "request": "launch",
            "program": "gunicorn",
            "console": "internalConsole",
            "cwd": "${workspaceFolder}/das",
            "env": {
                "DJANGO_SETTINGS_MODULE": "das_server.local_settings_docker_pooler",
                "ROOT_LOGGING_LEVEL": "INFO"
            },
            "args": [
                "das_server.wsgi",
                "--name",
                "das",
                "--limit-request-line",
                "8190",
                "--bind",
                "127.0.0.1:8000",
                "--workers",
                "1",
                "--threads",
                "1",
                "-c",
                "das_server/gunicorn.conf.py"
            ],
            "django": true,
            "justMyCode": false
        },
        {
            "name": "Django:GunicornRT",
            "type": "debugpy",
            "request": "launch",
            "program": "gunicorn",
            "console": "internalConsole",
            "cwd": "${workspaceFolder}/das",
            "gevent": true,
            "justMyCode": false,
            "args": [
                "das_server.rt_wsgi",
                "--name",
                "das_rt",
                "--limit-request-line",
                "8190",
                "--bind",
                "127.0.0.1:8000",
                "--workers",
                "1",
                "--worker-tmp-dir",
                "/dev/shm",
                "--worker-class",
                "eventlet",
                "--timeout",
                "600",
                "--log-level",
                "info"
            ],
            "env": {
                "ROOT_LOGGING_LEVEL": "INFO",
                "DJANGO_SETTINGS_MODULE": "das_server.local_settings_docker_pooler"
            }
        },
        {
            "name": "ER Workers",
            "type": "debugpy",
            "request": "launch",
            "program": "celery",
            "console": "internalConsole",
            "cwd": "${workspaceFolder}/das",
            "args": [
                "-A",
                "das_server",
                "worker",
                "--beat",
                "-s",
                "/tmp/celerybeat-schedule",
                "-Q",
                "realtime_p1,realtime_p2,realtime_p3,default,analyzers,maintenance",
                "-l",
                "info",
                "-c",
                "2",
                "--without-gossip",
                "-n",
                "all-in-one"
            ],
            //"postDebugTask": "killdebugger",
            "env": {
                "DJANGO_SETTINGS_MODULE": "das_server.local_settings_docker_pooler",
                "GEVENT_SUPPORT": "True"
            }
        },
        {
            "name": "Django:MQL",
            "type": "debugpy",
            "request": "launch",
            "program": "manage.py",
            "console": "internalConsole",
            "cwd": "${workspaceFolder}/das",
            "args": [
                "message_queue_listeners"
            ],
            "django": true,
            "env": {
                "ROOT_LOGGING_LEVEL": "INFO",
                "DJANGO_SETTINGS_MODULE": "das_server.local_settings_docker_pooler"
            }
        },
        {
            "name": "Django:RunRT",
            "type": "debugpy",
            "request": "launch",
            "program": "async_manage.py",
            "console": "internalConsole",
            "cwd": "${workspaceFolder}/das",
            "gevent": true,
            "justMyCode": false,
            "args": [
                "rtserver",
                "localhost:8000",
                "--noreload",
                "--nothreading"
            ],
            "env": {
                "DJANGO_SETTINGS_MODULE": "das_server.local_settings_docker_pooler"
            },
            "django": true
        },
        {
            "name": "Django manage tenant command",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "program": "manage.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/das",
            "args": [
                "${input:django_command}",
                "--tenant_domain",
                "${input:tenant_domain}",
                "${input:django_command_args}"
            ],
            "django": true,
            "env": {
                "DJANGO_SETTINGS_MODULE": "das_server.local_settings_docker_pooler"
            }
        },
        {
            "name": "Django manage command",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "program": "manage.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/das",
            "args": [
                "${input:django_command}",
                "${input:django_command_args}"
            ],
            "django": true,
            "sudo": true,
            "env": {
                "DJANGO_SETTINGS_MODULE": "das_server.local_settings_docker_pooler"
            }
        },
        {
            "name": "Django migrate db",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "program": "manage.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/das",
            "args": [
                "migrate"
            ],
            "django": true,
            "env": {
                "IS_OAUTH2_PROVIDER_MIGRATION": "True",
                "DJANGO_SETTINGS_MODULE": "das_server.local_settings_docker_pooler"
            }
        },
        {
            "name": "Django initial data",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "program": "manage.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/das",
            "args": [
                "loaddata_with_tenant",
                "--tenant_domain",
                "${input:tenant_domain}",
                "initial_admin",
                "initial_groups",
                "initial_eventdata",
                "initial_dev_map",
                "initial_features",
                "initial_tilelayers",
                "event_data_model",
            ],
            "django": true,
            "env": {
                "IS_OAUTH2_PROVIDER_MIGRATION": "True",
                "DJANGO_SETTINGS_MODULE": "das_server.local_settings_docker_pooler"
            }
        },
        {
            "name": "New tenant initial data",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "program": "manage.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/das",
            "args": [
                "loaddata_with_tenant",
                "--tenant_domain",
                "${input:tenant_domain}",
                "initial_data"
            ],
            "django": true,
            "env": {
                "IS_OAUTH2_PROVIDER_MIGRATION": "True",
                "DJANGO_SETTINGS_MODULE": "das_server.local_settings_docker_pooler"
            }
        },
        {
            "name": "Django collectstatic",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "program": "manage.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/das",
            "args": [
                "collectstatic"
            ],
            "django": true,
            "sudo": true,
            "env": {
                "DJANGO_SETTINGS_MODULE": "das_server.local_settings_docker_pooler"
            }
        },
        {
            "name": "Django dumpdata",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "program": "${workspaceFolder}/das/manage.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/das",
            "args": [
                "dumpdata",
                "--natural-primary",
                "--natural-foreign",
                "--all",
                "--format",
                "json",
                "--indent",
                "2",
                "--output",
                "das_server/fixtures/initial_data.json",
            ],
            "django": true,
            "env": {
                "DJANGO_SETTINGS_MODULE": "das_server.local_settings_docker_pooler",
                "IS_OAUTH2_PROVIDER_MIGRATION": "True"
            }
        },
        {
            "name": "Django make migrations",
            "type": "debugpy",
            "request": "launch",
            "python": "/home/vscode/.venv/bin/python",
            "justMyCode": false,
            "program": "${workspaceFolder}/das/manage.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/das",
            "args": [
                "makemigrations",
                "${input:django_migrate_app_options}",
            ],
            "django": true,
            "env": {
                "DJANGO_SETTINGS_MODULE": "das_server.local_settings_docker_pooler"
            }
        },
    ],
    "inputs": [
        {
            "id": "django_command",
            "type": "promptString",
            "description": "Django commands",
            "default": "dumpdata"
        },
        {
            "id": "django_command_args",
            "type": "promptString",
            "description": "Django commands args. Example: -o datajson.",
        },
        {
            "id": "pytest_path_args",
            "type": "promptString",
            "description": "pytest custom path (empty to execute the full test suite)",
            "default": "activity/tests"
        },
        {
            "id": "tenant_domain",
            "type": "promptString",
            "description": "tenant domain name",
            "default": "localhost"
        },
        {
            "id": "django_migrate_app_options",
            "type": "pickString",
            "description": "Select a DjangoApp to migrate",
            "options": [
                "activity",
                "accounts",
                "analyzers",
                "choices",
                "buoy",
                "core",
                "observations",
                "mapping",
            ],
            "default": "activity"
        }
    ]
}
