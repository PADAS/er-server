{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "PyTest",
            "type": "python",
            "request": "launch",
            "stopOnEntry": false,
          
            "module": "pytest",
            "args": [
                
            ],
            "cwd": "${workspaceRoot}",
            "env": {},
            "envFile": "${workspaceRoot}/.env",
            "debugOptions": [
                "WaitOnAbnormalExit",
                "WaitOnNormalExit",
                "RedirectOutput"
            ]
        },
        {
            "name": "Locust",
            "type": "python",
            "request": "launch",
            "module": "locust",
            "gevent": true,
            "cwd": "${workspaceFolder}/tests/load_tests/",
            "envFile": "${workspaceFolder}/tests/load_tests/locust.env",
            "justMyCode": false,
            "args": [
                "--host",
                "http://localhost:8000"
            ]
        },
        {
            "name": "Django:Run",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/das/manage.py",
            "console": "internalConsole",
            "cwd": "${workspaceFolder}/das",
            "env": {
                "DJANGO_SETTINGS_MODULE": "das_server.local_settings"
            },
            "args": [
                "runserver",
                "--noreload"
            ],
            "django": true
        },
        {
            "name": "Django:Gunicorn",
            "type": "python",
            "request": "launch",
            "program": "/usr/local/bin/gunicorn",
            "console": "internalConsole",
            "cwd": "${workspaceFolder}/das",
            "env": {
                "DJANGO_SETTINGS_MODULE": "das_server.local_settings"
            },
            "args": [
                "das_server.wsgi",
                "--name",
                "das",
                "--limit-request-line",
                "6000",
                "--bind",
                "127.0.0.1:8000",
                "--workers",
                "1",
                "--threads",
                "1"
            ],
            "django": true,
            "justMyCode": false
        },
        {
            "name": "Django:GunicornRT",
            "type": "python",
            "request": "launch",
            "program": "/usr/local/bin/gunicorn",
            "console": "internalConsole",
            "cwd": "${workspaceFolder}/das",
            "args": [
                "das_server.rt_wsgi",
                "--name",
                "das_rt",
                "--limit-request-line",
                "6000",
                "--bind",
                "127.0.0.1:8000",
                "--workers",
                "1",
                "--worker-tmp-dir",
                "/dev/shm",
                "--worker-class",
                "eventlet",
                "--timeout",
                "90",
                "--log-level",
                "info"
            ]
        },
        {
            "name": "ER Workers",
            "type": "python",
            "request": "launch",
            "module": "celery",
            "console": "internalConsole",
            "cwd": "${workspaceFolder}/das",
            "args": [
                "-A",
                "das_server",
                "worker",
                "-Q",
                "realtime_p1,realtime_p2,realtime_p3,default,maintenance",
                "-l",
                "info",
                "-c",
                "15",
                "-P",
                "gevent",
                "--without-gossip",
                "-n",
                "priority"
            ],
            "postDebugTask": "killdebugger",
            "django": true,
            "env":{
                "DJANGO_SETTINGS_MODULE": "das_server.local_settings",
            }
        },
        {
            "name": "Django:MQL",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/das/manage.py",
            "console": "internalConsole",
            "cwd": "${workspaceFolder}/das",
            "args": [
                "message_queue_listeners"
            ],
            "django": true
        },
        {
            "name": "Django:RunRT",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/das/async_manage.py",
            "console": "internalConsole",
            "cwd": "${workspaceFolder}/das",
            "args": [
                "rtserver",
                "localhost:8000",
                "--noreload",
                "--nothreading"
            ],
            "django": true
        },
        {
            "name": "Django manage command",
            "type": "python",
            "request": "launch",
            "justMyCode": false,
            "program": "${workspaceFolder}/das/manage.py",
            "console": "internalConsole",
            "cwd": "${workspaceFolder}/das",
            "args": [
                "firms"
            ],
            "django": true
        },
        {
            "name": "Django UnitTest",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/das/manage.py",
            "cwd": "${workspaceFolder}/das",
            "args": [
                "test"
            ],
            "django": true
        },
        {
            "name": "Django UnitTest File",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/das/manage.py",
            "cwd": "${workspaceFolder}/das",
            "args": [
                "test",
                "activity.tests.test_events.TestEventView.test_bad_request_with_empty_string_location"
            ],
            "django": true
        },
        {
            "name": "Debug Tests",
            "type": "python",
            "request": "launch",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}